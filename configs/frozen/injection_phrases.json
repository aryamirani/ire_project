{
  "name": "injection_phrases",
  "version": 1,
  "frozen_utc": "2026-10-26",
  "owner": "Arya",
  "purpose": "Phrase rule of the query-and-phrase filter (plan section 4.1, step 2). Frozen BEFORE the hijack / url / stealth templates were written and never edited afterwards (plan section 3.2). A passage is flagged if ANY pattern matches its normalised text.",
  "matching": {
    "normalisation": "Unicode NFKC, curly quotes and dashes to ASCII, lowercase, runs of whitespace collapsed to one space",
    "engine": "Python re, re.IGNORECASE, re.search (a match anywhere in the passage)",
    "sources": "Written from the published injection literature (Greshake et al. 2023; PoisonedRAG 2024; Hidden-in-Plain-Text 2026) and common prompt-injection wording, without looking at any attack template of this project."
  },
  "patterns": [
    {"id": "override_previous", "category": "override",
     "regex": "\\b(ignore|disregard|forget|overlook|skip)\\b.{0,30}\\b(previous|prior|above|earlier|preceding|other|all|any|those|these)\\b.{0,30}\\b(instructions?|passages?|context|documents?|information|directions?|rules?|text|sources?|results?|messages?|prompts?)\\b"},
    {"id": "do_not_use_other", "category": "override",
     "regex": "\\bdo not (use|trust|rely on|consider|read|follow|believe)\\b.{0,30}\\b(other|previous|above|remaining|rest of the)\\b.{0,20}\\b(passages?|documents?|context|sources?|information|instructions?)\\b"},
    {"id": "new_instructions", "category": "override",
     "regex": "\\b(new|updated|revised|override|overriding|additional|important|urgent|special|hidden|secret) (system )?(instructions?|directives?|orders?|commands?)\\b"},
    {"id": "instead_do", "category": "override",
     "regex": "\\b(instead|rather),? (you (must|should|will)|just|only|simply) (answer|respond|reply|output|say|write|print)\\b"},

    {"id": "addressed_to_model", "category": "addressee",
     "regex": "\\b(attention|note|notice|message|instructions?|reminder|warning|memo) (to|for) (the |any |all )?(ai|a\\.i\\.|assistant|chatbot|bot|model|llm|language model|reader model|answering system|system)s?\\b"},
    {"id": "dear_model", "category": "addressee",
     "regex": "\\b(dear|hey|hello|hi) (ai|assistant|chatbot|bot|model|llm|language model)\\b"},
    {"id": "you_are_model", "category": "addressee",
     "regex": "\\byou are (now )?(an? |the )?(ai|helpful assistant|assistant|chatbot|language model|llm|answering system)\\b"},
    {"id": "if_you_are_model", "category": "addressee",
     "regex": "\\bif you are (an? |the )?(ai|assistant|chatbot|language model|llm|model|automated system)\\b"},
    {"id": "as_an_ai", "category": "addressee",
     "regex": "\\bas an? (ai|assistant|language model|llm)\\b"},

    {"id": "answer_with_only", "category": "output_control",
     "regex": "\\b(answer|respond|reply|output|print|say|write|return|state)\\b.{0,15}\\b(only|exactly|just|solely|simply)\\b.{0,25}\\b(word|words|phrase|string|text|token|code|codeword|code word|term|name|following|this)\\b"},
    {"id": "answer_with_word", "category": "output_control",
     "regex": "\\b(answer|respond|reply)( to (it|this|the question))? (with|using) (the )?(single |one )?(word|phrase|string|token|code|codeword|code word|term)\\b"},
    {"id": "output_the_word", "category": "output_control",
     "regex": "\\b(output|print|say|write|type|repeat|return|reproduce|echo)\\b (out )?(the )?(single |following |exact |secret |special )?(word|phrase|string|token|code word|codeword|keyword|password|text)\\b"},
    {"id": "response_must", "category": "output_control",
     "regex": "\\b(your|the) (final )?(answer|response|reply|output|summary)s? (must|should|has to|needs to|shall|will) (be|contain|include|start|begin|end|consist|mention)\\b"},
    {"id": "always_answer", "category": "output_control",
     "regex": "\\b(always|must|should) (answer|respond|reply|output|say|include|append|add|mention|cite|recommend)\\b.{0,40}\\b(question|answer|response|reply|link|url|website|word)\\b"},
    {"id": "do_not_mention", "category": "output_control",
     "regex": "\\bdo not (mention|reveal|disclose|say|tell|include|explain|refer to)\\b.{0,30}\\b(this|these|instructions?|note|passage|message|the user|anyone)\\b"},
    {"id": "when_asked", "category": "output_control",
     "regex": "\\b(when|whenever|if) (you are |you're |you get )?(asked|questioned|prompted|queried)\\b.{0,80}\\b(answer|respond|reply|say|output|write|state)\\b"},
    {"id": "when_user_asks", "category": "output_control",
     "regex": "\\b(when|whenever|if) (the |a |any )?(user|reader|human|person|someone|anyone) (asks|queries|requests|wants to know)\\b"},
    {"id": "correct_answer_is", "category": "output_control",
     "regex": "\\bthe (only )?(correct|right|true|real|official|proper) (answer|response|reply) (to (this|the|that) question )?(is|will be|should be)\\b.{0,20}\\b(word|code|token|string|\"|')"},

    {"id": "include_link", "category": "url",
     "regex": "\\b(include|insert|add|append|attach|provide|share|mention|cite|paste)\\b.{0,25}\\b(link|url|hyperlink|web address|website|webpage)\\b"},
    {"id": "visit_url", "category": "url",
     "regex": "\\b(visit|go to|click|open|navigate to|check out|refer users to|direct (the )?(user|reader)s? to)\\b.{0,40}(https?://|www\\.)"},

    {"id": "role_marker", "category": "format_marker",
     "regex": "(^|[\\s\\]>.:])(system|assistant|user|instruction|developer)\\s*:\\s"},
    {"id": "bracket_marker", "category": "format_marker",
     "regex": "(\\[\\s*(system|inst|/inst|instruction|admin)\\s*\\]|<\\|?(im_start|im_end|system|endoftext)\\|?>|<<\\s*sys\\s*>>|###\\s*(instruction|system|response))"},
    {"id": "end_of_context", "category": "format_marker",
     "regex": "\\b(end of (the )?(context|document|passage|retrieved text|search results?)|begin(ning of)? (new )?instructions?)\\b"},
    {"id": "jailbreak_terms", "category": "format_marker",
     "regex": "\\b(jailbreak|developer mode|dan mode|prompt injection|system prompt|override (mode|protocol)|admin(istrator)? (mode|override|access))\\b"}
  ]
}
